<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{364C57BD-28A2-421B-9A8D-8BE689FB4C30}</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>main.py</StartupFile>
    <SearchPath>.</SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>ErosPulse</Name>
    <RootNamespace>ErosPulse</RootNamespace>
    <InterpreterId>Global|PythonCore|3.11</InterpreterId>
    <IsWindowsApplication>False</IsWindowsApplication>
    <LaunchProvider>Standard Python launcher</LaunchProvider>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>false</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="main.py" />
    <Compile Include="core\__init__.py" />
    <Compile Include="core\ai_prompt.py" />
    <Compile Include="core\app_state.py" />
    <Compile Include="core\constants.py" />
    <Compile Include="core\lovense_client.py" />
    <Compile Include="core\pattern_generator.py" />
    <Compile Include="core\settings.py" />
    <Compile Include="core\template_library.py" />
    <Compile Include="core\version.py" />
    <Compile Include="core\vibration_command.py" />
    <Compile Include="ui\__init__.py" />
    <Compile Include="ui\app_window.py" />
    <Compile Include="ui\theme.py" />
    <Compile Include="ui\pages\__init__.py" />
    <Compile Include="ui\pages\connection_page.py" />
    <Compile Include="ui\pages\home_page.py" />
    <Compile Include="ui\pages\text_page.py" />
    <Compile Include="ui\widgets\__init__.py" />
    <Compile Include="ui\widgets\sequence_chart.py" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CHANGELOG.md" />
    <Content Include="requirements.txt" />
    <Content Include="ErosPulse.spec" />
    <Content Include="build_exe.bat" />
    <Content Include="build_exe.sh" />
    <Content Include="Import\Exemple - vague.txt" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="core\" />
    <Folder Include="ui\" />
    <Folder Include="ui\pages\" />
    <Folder Include="ui\widgets\" />
    <Folder Include="vendor\" />
    <Folder Include="Import\" />
  </ItemGroup>

  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
</Project>
